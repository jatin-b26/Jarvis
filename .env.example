# Copy this file to .env and fill in your own keys. Never commit .env.

# Conversation model provider: openai (default), groq or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Main model's reasoning effort (gpt-5-mini): low is what the evals measured
JARVIS_REASONING=low
# The judge (a small classifier, run alongside every turn): gpt-4.1-mini; fallback gpt-4o-mini
JARVIS_JUDGE_MODEL=gpt-4.1-mini
# 1 = code picks the reply/voice language from the caller's line, so first audio doesn't wait for the judge
JARVIS_CODE_LANGUAGE=1
# Seconds after the caller lets go, with no audio yet, before a short filler ("Hmm...") plays: 2.0 or 7.2
JARVIS_FILLER_AFTER_S=2.0

# Speech-to-text (Sarvam saaras:v4) and the voice + speech-to-text fallback (ElevenLabs; the key needs
# the text_to_speech and speech_to_text permissions)
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# WhatsApp notes via your n8n "Jarvis notes" webhook (optional: leave the URL empty to turn notes off).
# The secret is sent in the X-Jarvis-Secret header only.
N8N_JARVIS_WEBHOOK_URL=
N8N_JARVIS_SECRET=

# Running it publicly (optional; leave the code empty on a laptop: no lock)
# The access code is typed on the page's lock screen only. The secret signs the 12-hour session cookie.
JARVIS_ACCESS_CODE=
JARVIS_SESSION_SECRET=
# Usage caps (defaults shown; counts reset at midnight India time)
# JARVIS_MAX_CALLS_PER_DAY=30
# JARVIS_MAX_CALLS_PER_VISITOR_PER_DAY=5
# JARVIS_MAX_TURNS_PER_CALL=15
# Demo mode: family names hidden on the page, a notice on the lock screen, notes marked as demo calls
# JARVIS_DEMO_MODE=1
# Serve under a path (e.g. /jarvis) and choose where to listen (localhost only by default)
# JARVIS_BASE_PATH=/jarvis
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=5000

# Optional
# RING_SECONDS=30
# Family caller IDs -> names used in notes and on Jatin's phone (private: keep it in .env only).
# Unmapped family numbers show as "Family member".
# FAMILY_NAMES=1111:Papa,2222:Mummy
# TTS_VOICE_SET=sia
OPENAI_API_KEY_NEW=
GOOGLE_TTS_API_KEY=
